{
  "manifest_version": 3,
  "name": "Parental Control Browser Sharing",
  "short_name": "Browser Sharing",
  "description": "Visibly shares bounded tab titles and query-free origins with your paired parent controller when enabled.",
  "version": "0.5.0.1",
  "version_name": "0.5.0-rc.1",
  "key": "",
  "permissions": ["tabs", "storage", "nativeMessaging", "alarms"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Parental Control Browser Sharing",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
