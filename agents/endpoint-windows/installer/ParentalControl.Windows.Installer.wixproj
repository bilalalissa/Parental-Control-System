<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputName>ParentalControlWindows-0.8.0-rc.4-x64</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <Cultures>en-US</Cultures>
    <DefineConstants>PayloadDir=$(PayloadDir)</DefineConstants>
    <SuppressIces>ICE61</SuppressIces>
  </PropertyGroup>
</Project>
