#!/bin/bash
set -euo pipefail

TARGET_VOLUME="${3:-/}"
SUPPORT="$TARGET_VOLUME/Library/Application Support/ParentalControlAgent"
MARKER="$SUPPORT/.installer-maintenance.plist"

# Stop the current visible-session helper before package replacement. This also halts a stale
# RC3 fail-closed relock loop while the administrator-authorized upgrade is in progress.
if [[ "$TARGET_VOLUME" == "/" ]]; then
  CONSOLE_UID="$(/usr/bin/stat -f '%u' /dev/console)"
  if [[ "$CONSOLE_UID" =~ ^[0-9]+$ ]] && (( CONSOLE_UID >= 500 )); then
    USER_SERVICE="gui/$CONSOLE_UID/com.bilalalissa.ParentalControlAgent.user"
    /bin/launchctl bootout "$USER_SERVICE" >/dev/null 2>&1 || true
    /usr/bin/pkill -u "$CONSOLE_UID" -x ParentalControlAgentUser >/dev/null 2>&1 || true
  fi
fi

# Give only this administrator-authorized installer run a short fail-safe recovery window. The
# daemon consumes this root-only marker once; it rejects stale or longer-than-ten-minute values.
/bin/mkdir -p "$SUPPORT"
/usr/sbin/chown root:wheel "$SUPPORT"
/bin/chmod 700 "$SUPPORT"
ISSUED_AT="$(/bin/date +%s)"
EXPIRES_AT="$((ISSUED_AT + 600))"
TEMP_MARKER="$SUPPORT/.installer-maintenance.$$.tmp"
/usr/bin/plutil -create xml1 "$TEMP_MARKER"
/usr/libexec/PlistBuddy -c "Add :issuedAtEpoch integer $ISSUED_AT" "$TEMP_MARKER"
/usr/libexec/PlistBuddy -c "Add :expiresAtEpoch integer $EXPIRES_AT" "$TEMP_MARKER"
/usr/sbin/chown root:wheel "$TEMP_MARKER"
/bin/chmod 600 "$TEMP_MARKER"
/bin/mv -f "$TEMP_MARKER" "$MARKER"
