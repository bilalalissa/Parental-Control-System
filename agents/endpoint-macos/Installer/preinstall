#!/bin/bash
set -euo pipefail

TARGET_VOLUME="${3:-/}"
SUPPORT="$TARGET_VOLUME/Library/Application Support/ParentalControlAgent"
CONFIGURATION="$SUPPORT/configuration.json"
INSTALLED_DAEMON="$TARGET_VOLUME/Library/PrivilegedHelperTools/com.bilalalissa.ParentalControlAgent.daemon"
BRIDGE="$SUPPORT/.rc5-daemon-upgrade"
RC5_DAEMON_SHA256="0bb256f6135e59e5b217d11894d9848c6f64529ec5dccd6c4c0d14d853b52a66"

/bin/rm -f -- "$BRIDGE"
if [[ -f "$CONFIGURATION" && -x "$INSTALLED_DAEMON" ]]; then
  INSTALLED_SHA256="$(/usr/bin/shasum -a 256 "$INSTALLED_DAEMON" | /usr/bin/awk '{print $1}')"
  if [[ "$INSTALLED_SHA256" == "$RC5_DAEMON_SHA256" ]]; then
    # The rc.5 ad-hoc code requirement cannot be inherited by a changed executable. Use a new,
    # allowlisted Keychain service and require one adult-authorized pairing repair. Never export
    # or copy the old private key to disk.
    if /usr/bin/plutil -extract identityKeychainService raw "$CONFIGURATION" >/dev/null 2>&1; then
      /usr/bin/plutil -replace identityKeychainService -string \
        "com.bilalalissa.ParentalControlAgent.device.rc3" "$CONFIGURATION"
    else
      /usr/bin/plutil -insert identityKeychainService -string \
        "com.bilalalissa.ParentalControlAgent.device.rc3" "$CONFIGURATION"
    fi
    /usr/sbin/chown root:wheel "$CONFIGURATION"
    /bin/chmod 600 "$CONFIGURATION"
  fi
fi
