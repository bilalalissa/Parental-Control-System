<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>Parental Control System</title>
  <organization>com.bilalalissa.ParentalControlSystem</organization>
  <domains enable_localSystem="true" enable_currentUserHome="false" enable_anywhere="false"/>
  <options customize="always" require-scripts="false" hostArchitectures="arm64,x86_64"/>
  <welcome file="Welcome.html" mime-type="text/html"/>
  <choices-outline>
    <line choice="parent-controller"/>
    <line choice="child-endpoint"/>
  </choices-outline>
  <choice id="parent-controller"
          title="Parent Controller"
          description="Install the Apple-silicon Parent Controller on the parent’s Mac. This is selected by default."
          start_selected="true" start_enabled="true" start_visible="true">
    <pkg-ref id="com.bilalalissa.ParentalControlController.component"/>
  </choice>
  <choice id="child-endpoint"
          title="Child Endpoint"
          description="Install or update the visible universal child app, boot daemon, and login helper. In-place updates preserve pairing; the uninstaller intentionally removes pairing data."
          start_selected="false" start_enabled="true" start_visible="true">
    <pkg-ref id="com.bilalalissa.ParentalControlChild.component"/>
  </choice>
  <pkg-ref id="com.bilalalissa.ParentalControlController.component" version="0.6.1.3" onConclusion="none">ParentalControlController.pkg</pkg-ref>
  <pkg-ref id="com.bilalalissa.ParentalControlChild.component" version="0.6.1.3" onConclusion="none">ParentalControlChild.pkg</pkg-ref>
</installer-gui-script>
