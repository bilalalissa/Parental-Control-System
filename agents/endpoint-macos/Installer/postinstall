#!/bin/bash
set -euo pipefail

TARGET_VOLUME="${3:-/}"
SUPPORT="$TARGET_VOLUME/Library/Application Support/ParentalControlAgent"
mkdir -p "$SUPPORT/Logs"
chown -R root:wheel "$SUPPORT"
chmod 700 "$SUPPORT" "$SUPPORT/Logs"
chmod 644 "$TARGET_VOLUME/Library/LaunchDaemons/com.bilalalissa.ParentalControlAgent.daemon.plist"
chmod 644 "$TARGET_VOLUME/Library/LaunchAgents/com.bilalalissa.ParentalControlAgent.user.plist"
chmod 755 "$TARGET_VOLUME/Library/PrivilegedHelperTools/com.bilalalissa.ParentalControlAgent.daemon"

if [[ "$TARGET_VOLUME" == "/" ]]; then
  /bin/launchctl bootout system/com.bilalalissa.ParentalControlAgent.daemon >/dev/null 2>&1 || true
  for attempt in 1 2 3; do
    if /bin/launchctl bootstrap system /Library/LaunchDaemons/com.bilalalissa.ParentalControlAgent.daemon.plist; then
      exit 0
    fi
    if [[ "$attempt" != 3 ]]; then /bin/sleep 2; fi
  done
  echo "Unable to start the endpoint daemon after three attempts." >&2
  exit 1
fi
