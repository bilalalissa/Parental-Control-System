{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bilalalissa/Parental-Control-System/docs/stages/stage-status.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["activeStage", "stages"],
  "properties": {
    "activeStage": {"type": "string", "pattern": "^STAGE-[0-9]{2}[A-Z]?$"},
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "version", "status", "branch", "document"],
        "properties": {
          "id": {"type": "string", "pattern": "^STAGE-[0-9]{2}[A-Z]?$"},
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+-rc\\.[0-9]+$"},
          "status": {"enum": ["PLANNED", "IMPLEMENTING", "READY_FOR_DEVELOPER_TEST", "CHANGES_REQUESTED", "READY_FOR_RETEST", "APPROVED", "MERGED", "BLOCKED"]},
          "branch": {"type": "string", "minLength": 1},
          "document": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
